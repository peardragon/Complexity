{
  "stage": "01_dataset",
  "production_scope": "MNIST manual-rule datasets",
  "raw_output_layout": "raw_outputs/rule_*",
  "entrypoints": [
    "src/make_dataset.py",
    "src/make_summarized_outputs.py",
    "src/make_figures.py"
  ],
  "dataset_family": "MNIST 10x10 manual rules",
  "dataset_policy": "Builds or validates MNIST manual-rule payloads from a stage-local OpenML MNIST cache at raw_outputs/original_mnist/mnist_openml_uint8.npz, then rebuilds local metadata, summaries, and figures.",
  "source": {
    "original_mnist": "raw_outputs/original_mnist/mnist_openml_uint8.npz",
    "openml_dataset": "mnist_784",
    "split_seed": 20260610,
    "download_if_missing": true
  },
  "generation": {
    "downscale": "PIL.Image.resize((10, 10), Image.Resampling.BOX)",
    "standardization": "train mean/std on X_train_raw10, std floor 1e-6 -> 1.0",
    "teacher_nn": {
      "seed": 31001,
      "architecture": "100-20-20-1-tanh",
      "threshold": "median teacher logit on train split"
    },
    "random_label": {
      "train_seed": 41001,
      "test_seed": 42001,
      "class_balance": "exact 50/50 +/-1"
    },
    "very_low_tv_spectral_teacher": {
      "graph_k_values": [8, 16, 32],
      "selection_graph_k": 16,
      "spectral_ks": [3, 4, 6, 8, 12],
      "max_draws_per_basis": 25000,
      "rng_seed": 20260618
    }
  },
  "rules": [
    {
      "rule_id": "rule_001",
      "rule_name": "very_low_tv_spectral_teacher",
      "label": "very low tv",
      "raw_dataset": "raw_outputs/rule_001/dataset.npz"
    },
    {
      "rule_id": "rule_002",
      "rule_name": "real_even_odd",
      "label": "even odd",
      "raw_dataset": "raw_outputs/rule_002/dataset.npz"
    },
    {
      "rule_id": "rule_003",
      "rule_name": "teacher_nn",
      "label": "teacher nn",
      "raw_dataset": "raw_outputs/rule_003/dataset.npz"
    },
    {
      "rule_id": "rule_004",
      "rule_name": "random_label",
      "label": "random",
      "raw_dataset": "raw_outputs/rule_004/dataset.npz"
    }
  ],
  "n_train": 512,
  "n_test": 2048,
  "input_shape": "10x10",
  "sample_figure": {
    "source_array": "X_train_raw10",
    "samples_per_rule": 8
  },
  "retained_figures": [
    "figures/sample_figure.png"
  ],
  "summary_outputs": [
    "summarized_outputs/figure_inputs/sample_figure/selected_sample_indices.csv"
  ],
  "metadata_outputs": [
    "raw_outputs/rule_*/dataset_meta.json"
  ]
}
